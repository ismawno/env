// The wallpaper picker: the usual theme as a vertical list, a thumbnail on the left and the full name beside it.

@import "~/.config/rofi/gruvbox-material.rasi"

window {
  width: 960px;
  height: 0px;
}

entry {
  placeholder: "Search wallpapers";
  placeholder-color: @gruv8;
}

listview {
  columns: 1;
  lines: 5;
  fixed-height: true;
  spacing: 4px;
  scrollbar: false;
}

element {
  orientation: horizontal;
  padding: 6px 10px;
  spacing: 14px;
  border: 2px;
  border-color: transparent;
}

element.selected.normal {
  border-color: @gruv6;
}

// wallpaper-pick breaks names to fit this width: its wrap_width counts characters of this font.
element-text {
  font: "JetBrainsMono 11";
  horizontal-align: 0.5;
  vertical-align: 0.5;
  margin: 0;
  text-color: inherit;
}

// The icon box is always square; the thumbnails are all 16:10, so this trims the bands above and below them.
element-icon {
  size: 144px;
  padding: -27px 0px;
  margin: 0;
}
