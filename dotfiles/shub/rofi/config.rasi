configuration {
    show-icons: false;
    font: "JetBrainsMono 12";
    icon-theme: "Gruvbox-Plus-Dark";

    display-ssh:    "󰣀 ssh:";
    display-run:    "󱓞 run:";
    display-drun:   "󰣖 drun:";
    display-window: "󱂬 window:";
    display-combi:  "󰕘 combi:";
    display-filebrowser: "󰉋 filebrowser:";

    drun-display-format: "{name} [<span alpha='55%' size='small'><i>{generic}</i></span>]";
    matching: "fuzzy";
    case-sensitive: false;
    sort: true;
    sorting-method: "fzf";
    dpi: 110;
}

@theme "~/.config/rofi/gruvbox-material.rasi"
