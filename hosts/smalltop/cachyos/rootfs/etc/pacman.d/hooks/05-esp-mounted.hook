[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/modules/*/extramodules/*
Target = usr/lib/initcpio/*
Target = usr/lib/firmware/*

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = mkinitcpio

[Action]
Description = Verifying the shared ESP is mounted at /boot...
When = PreTransaction
Exec = /usr/bin/mountpoint -q /boot
AbortOnFail
