+namespace {
+
+std::string luaString(const std::string& s) {
+  std::string out = "\"";
+  for (char c : s) {
+    if (c == '\\' || c == '"') {
+      out += '\\';
+    } else if (c == '\n') {
+      out += "\\n";
+      continue;
+    }
+    out += c;
+  }
+  return out + "\"";
+}
+
+// A Lua-config Hyprland evaluates "dispatch X" as "return hl.dispatch(X)", so hyprlang syntax fails there.
+void dispatch(const std::string& legacy, const std::string& lua) {
+  if (IPC::getSocket1Reply("dispatch " + legacy) != "ok") {
+    IPC::getSocket1Reply("dispatch " + lua);
+  }
+}
+
+std::string luaFocus(const std::string& workspace, bool onCurrentMonitor) {
+  return "hl.dsp.focus({ workspace = " + luaString(workspace) +
+         (onCurrentMonitor ? ", on_current_monitor = true })" : " })");
+}
+
