#!/bin/bash

build() {
    # mkswap is not a busybox applet, and the emergency-shell escape hatch needs it.
    add_binary mkswap
    add_runscript
}

help() {
    cat <<'HELPEOF'
Refuses to mount the shared btrfs unless the NixOS swap LV's header magic at byte
4086 reads exactly "SWAPSPACE2". Anything else -- S1SUSPEND, empty, unreadable,
missing device -- drops to an interactive shell.
HELPEOF
}
