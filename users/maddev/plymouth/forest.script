# Foggy forest with a bare passphrase field; every size follows the screen height.
sw = Window.GetWidth();
sh = Window.GetHeight();

bg = Image("background.png");
s = Math.Max(sw / bg.GetWidth(), sh / bg.GetHeight());
if (s != 1) bg = bg.Scale(bg.GetWidth() * s, bg.GetHeight() * s);
bg_sprite = Sprite(bg);
bg_sprite.SetPosition((sw - bg.GetWidth()) / 2, (sh - bg.GetHeight()) / 2, -100);

box = Image("entry-" + sh + ".png");
dot = Image("dot-" + sh + ".png");
if (!box || !dot) {
    box_h = Math.Int(sh * 0.052);
    dot_size = Math.Int(box_h * 0.26);
    box = Image("entry-2160.png").Scale(box_h * 8, box_h);
    dot = Image("dot-2160.png").Scale(dot_size, dot_size);
}
box_w = box.GetWidth();
box_h = box.GetHeight();
dot_size = dot.GetWidth();
box_y = sh * 0.40;
box_sprite = Sprite(box);
box_sprite.SetPosition((sw - box_w) / 2, box_y, 10);
box_sprite.SetOpacity(0);

dot_step = dot_size * 1.9;
max_dots = Math.Int((box_w - box_h) / dot_step);

font = "Sans " + Math.Int(sh / 75);
message_sprite = Sprite();

fun display_password_callback(prompt, bullets) {
    box_sprite.SetOpacity(1);
    for (i = 0; global.dots[i]; i++) global.dots[i].SetOpacity(0);
    n = Math.Min(bullets, max_dots);
    start = (sw - n * dot_step + (dot_step - dot_size)) / 2;
    for (i = 0; i < n; i++) {
        if (!global.dots[i]) global.dots[i] = Sprite(dot);
        global.dots[i].SetPosition(start + i * dot_step, box_y + (box_h - dot_size) / 2, 11);
        global.dots[i].SetOpacity(1);
    }
}

fun display_normal_callback() {
    box_sprite.SetOpacity(0);
    for (i = 0; global.dots[i]; i++) global.dots[i].SetOpacity(0);
}

fun message_callback(text) {
    m = Image.Text(text, 0.93, 0.93, 0.93, 1, font);
    message_sprite.SetImage(m);
    message_sprite.SetPosition((sw - m.GetWidth()) / 2, sh * 0.52, 10);
    message_sprite.SetOpacity(1);
}

fun hide_message_callback(text) {
    message_sprite.SetOpacity(0);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayMessageFunction(message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
