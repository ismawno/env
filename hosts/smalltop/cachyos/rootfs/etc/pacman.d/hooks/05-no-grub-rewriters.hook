[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = grub-btrfs
Target = grub-hook
Target = os-prober
Target = efibootmgr

[Action]
Description = REFUSING: this package can rewrite grub.cfg or EFI entries on the shared ESP.
When = PreTransaction
Exec = /usr/bin/false
AbortOnFail
