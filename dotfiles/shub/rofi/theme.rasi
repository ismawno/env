// look.rasi, beside this file, holds the @look-* colours of the current theme.
@import "~/.config/rofi/look.rasi"

* {
  foreground: @look-dim;
  background-color: transparent;

  highlight: @look-highlight;

  transparent: rgba(0, 0, 0, 0.1);
}

window {
  location: center;
  anchor: center;
  border-radius: 0px;
  height: 560px;
  width: 600px;

  background-color: @look-window;
  spacing: 0;
  children: [mainbox];
  orientation: horizontal;
}

mainbox {
  spacing: 0;
  children: [inputbar, message, listview];
}

message {
  padding: 10px;
  border: 0px 2px 2px 2px;
  border-color: @look-bg;
  background-color: @transparent;
}

inputbar {
  children: [entry];
  color: @look-fg;
  padding: 14px;
  background-color: @transparent;
  border-color: @look-fg;

  border: 4px;
  border-radius: 0px;
}

entry {
  text-font: inherit;
  text-color: inherit;
  horizontal-align: 0.5;
}

listview {
  padding: 8px;
  border-radius: 0px;
  border: 0px 4px 4px 4px;
  border-color: @look-fg;
  background-color: @transparent;
  dynamic: false;
}

element {
  padding: 5px;
  vertical-align: 0.5;
  border-radius: 0px;
  color: @foreground;
  text-color: @look-fg;
  background-color: @transparent;
}

element.normal.active {
  background-color: @look-accent;
}

element.normal.urgent {
  background-color: @look-crit;
}

element.selected.normal {
  background-color: @look-subtle;
  text-color: @look-bg;
}

element.selected.active {
  background-color: @look-accent-dark;
}

element.selected.urgent {
  background-color: @look-crit-bright;
}

element.alternate.normal {
  background-color: @transparent;
}

element-text,
element-icon {
  size: 3ch;
  margin: 0 10 0 0;
  vertical-align: 0.5;
  text-color: @look-fg;
}
