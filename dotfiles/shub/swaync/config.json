{
  "$schema": "/etc/profiles/per-user/maddev/etc/xdg/swaync/configSchema.json",
  "control-center-layer": "overlay",
  "control-center-exclusive-zone": false,
  "control-center-margin-top": 20,
  "control-center-margin-bottom": 20,
  "control-center-margin-right": 20,
  "control-center-margin-left": 20,
  "notification-icon-size": 64,
  "timeout": 3,
  "timeout-low": 2,
  "fit-to-screen": false,
  "control-center-height": 820,
  "notification-window-width": 490,
  "hide-on-clear": true,
  "widgets": ["title", "notifications", "mpris"],
  "widget-config": {
    "title": {
      "text": "Notification Center",
      "clear-all-button": true,
      "button-text": "󰆴 Clear All"
    },
    "mpris": {
      "blacklist": ["playerctld"],
      "image-size": 96,
      "image-radius": 7
    }
  }
}
