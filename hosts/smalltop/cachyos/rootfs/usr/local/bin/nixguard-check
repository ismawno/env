#!/bin/sh
# Layer 3: exit non-zero unless the NixOS swap is idle. Optional $1 = device, for tests.
dev="$1"
if [ -z "$dev" ]; then
    dev=/dev/smalltop/nixos-swap
    [ -b "$dev" ] || dev=/dev/mapper/smalltop-nixos--swap
fi
[ -b "$dev" ] || { echo "nixguard: $dev not found -- refusing to hibernate" >&2; exit 1; }

magic=$(dd if="$dev" bs=1 skip=4086 count=10 2>/dev/null | tr -d '\0')
if [ "$magic" != "SWAPSPACE2" ]; then
    echo "nixguard: $dev magic is '${magic:-<empty>}', not SWAPSPACE2 -- refusing to hibernate" >&2
    exit 1
fi
exit 0
